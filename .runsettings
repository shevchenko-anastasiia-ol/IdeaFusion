<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="Code Coverage">
        <Configuration>
          <Exclude>
            <ModulePaths>
              <ModulePath>.*\.Tests\.dll</ModulePath>
              <ModulePath>.*Tests.*\.dll</ModulePath>
            </ModulePaths>
          </Exclude>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>