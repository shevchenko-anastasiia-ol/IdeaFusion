# Copy to `.env` and adjust. `.env` is gitignored; this template is tracked.
#
# Only the three Keycloak coordinates belong here. There is no client secret:
# `ideafusion-frontend` is a public client using Authorization Code + PKCE, so
# anything secret committed next to these values would be a mistake.

VITE_KEYCLOAK_URL=http://localhost:8080
VITE_KEYCLOAK_REALM=IdeaFusion
VITE_KEYCLOAK_CLIENT_ID=ideafusion-frontend
